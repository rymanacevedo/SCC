{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".next",
    ".cache",
    ".ona",
    "bin",
    ".wrangler",
    "docs",
    ".agents",
    ".claude",
    ".codex",
    "*.md"
  ],
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": false
}
