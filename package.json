{
  "name": "scc",
  "module": "index.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@scc/frontend...",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "sandcastle": "bun .sandcastle/main.ts",
    "typecheck": "bun run --cwd packages/frontend typecheck && bun run --cwd packages/backend typecheck",
    "test": "bun test",
    "prepare": "husky && bun run --cwd packages/backend types"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4",
    "turbo": "^2.11.0",
    "puppeteer": "24"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.4.3"
}
