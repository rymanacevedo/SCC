# Environment keys SCC reads.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# Comma-separated two-letter country codes the Worker serves.
# @required @type=string(matches=regex("^\s*[A-Za-z]{2}\s*(,\s*[A-Za-z]{2}\s*)*$"))
ALLOWED_COUNTRIES=
# GitHub repository, as owner/name, that receives reported issues.
# @required
GITHUB_REPO=
# GitHub token the Worker files reported issues with.
# @required @sensitive
GITHUB_TOKEN=
# API key for the model provider. Evals read it too.
# @required @sensitive
OPENAI_API_KEY=
# Base URL of an OpenAI-compatible provider.
# @type=url
OPENAI_BASE_URL=
# Model id the Worker generates with.
OPENAI_MODEL=

# Gemini API key. Only Evals read it.
# @sensitive
GEMINI_API_KEY=

# GitHub token Sandcastle passes to its sandbox. Set it in .sandcastle/.env.
# @sensitive
GH_TOKEN=

# Origin of the built app under a Flow test. The Flow test runner sets it.
SCC_E2E_ORIGIN=
# Path of the Chrome binary a Flow test drives. The Flow test runner sets it.
SCC_E2E_CHROME=
# Directory a Flow test downloads Exports into. The Flow test runner sets it.
SCC_E2E_DOWNLOADS=
# Port the Flow test's model stub listens on. The Flow test runner sets it.
PORT=

# Path of the Chrome binary the perf flow tool drives.
CHROME_PATH=
# Git tag the perf runbook measures. The Verdict tool checks that it tags HEAD.
PERF_TAG=
# Directory the perf runbook writes its measurements to.
PERF_DIR=
