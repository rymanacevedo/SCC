{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "./worker-configuration.d.ts",
      "bun",
      "node"
    ]
  },
  "include": [
    "worker/**/*.ts",
    "shared/**/*.ts",
    "evals/**/*.ts",
    "test/mock-model.ts"
  ]
}
